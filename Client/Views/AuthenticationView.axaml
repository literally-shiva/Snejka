<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:Client.Views"
             xmlns:vm="using:Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.AuthenticationView"
             x:DataType="vm:AuthenticationViewModel">

    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:LoginViewModel">
            <views:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="vm:RegisterViewModel">
            <views:RegisterView/>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid RowDefinitions="auto,*" ColumnDefinitions="*,*">
        <Button Content="Login" Command="{Binding LoginCommand}"/>
        <Button Grid.Column="1" Content="Register" Command="{Binding RegisterCommand}"/>
        <ContentControl Grid.Row="1" Grid.ColumnSpan="2" Content="{Binding CurrentViewModel}"/>
    </Grid>
</UserControl>
