{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Server",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/Server/bin/Debug/net10.0/Server.dll",
            "preLaunchTask": "build",
            "cwd": "${workspaceFolder}/Server",
            "launchSettingsProfile": "http"
        },
        {
            "name": "Client",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/Client/bin/Debug/net10.0/Client.dll",
            "preLaunchTask": "build",
            "cwd": "${workspaceFolder}/Client"
        }
    ],
    "compounds": [
        {
            "name": "Server + Client",
            "configurations": [
                "Server",
                "Client"
            ]
        }
    ]
}